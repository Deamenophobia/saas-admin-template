DATABASE_URL=postgresql://template:template@localhost:5432/template?schema=identity
PORT=4050
HOST=127.0.0.1
APP_NAME=SaaS Admin
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional, operator-configured credential provisioning service. Requires HTTPS in production.
PROVISIONER_URL=
PROVISIONER_TOKEN=
# Registration can be disabled after provisioning initial accounts.
ALLOW_REGISTRATION=true
# Optional site-wide OIDC providers. Keep real client secrets only in local environment/secrets storage.
# Register redirectUri as your FRONTEND callback, which posts code/state/iss to the completion API.
# Example shape (replace placeholders before enabling):
# OIDC_PROVIDERS='[{"id":"company","label":"Company SSO","issuer":"https://id.example.com","clientId":"registered-client-id","clientSecret":"replace-me","redirectUri":"https://app.example.com/auth/callback"}]'
OIDC_PROVIDERS=[]
SSO_FLOW_MINUTES=5
SSO_MFA_MINUTES=5
SSO_MFA_ATTEMPTS=5
OIDC_TIMEOUT_SECONDS=10
