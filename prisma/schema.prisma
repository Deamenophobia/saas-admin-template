// Extracted from kokoro-account and kokoro-pipeline; see docs/PROVENANCE.md.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
enum TokenPurpose {
  VERIFY
  RESET
}
enum OperationStatus {
  PENDING
  SUCCEEDED
  FAILED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String? @map("password_hash")
  emailVerified Boolean @default(false) @map("email_verified")
  disabled Boolean @default(false)
  isSuperAdmin Boolean @default(false) @map("is_super_admin")
  totpSecret String? @map("totp_secret")
  pendingTotpSecret String? @map("pending_totp_secret")
  totpLastStep Int @default(-1) @map("totp_last_step")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  memberships Membership[]
  sessions Session[]
  tokens AccountToken[]
  apiKeys ApiKey[]
  recoveryCodes RecoveryCode[]
  externalIdentities ExternalIdentity[]
  @@map("users")
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  suspended Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  memberships Membership[]
  invitations Invitation[]
  serviceAccounts ServiceAccount[]
  apiKeys ApiKey[]
  credentials Credential[]
  operations Operation[]
  @@map("organizations")
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  orgId String @db.Uuid @map("organization_id")
  role MemberRole @default(MEMBER)
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid @map("organization_id")
  email String
  role MemberRole
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  acceptedAt DateTime? @db.Timestamptz @map("accepted_at")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@index([orgId, email])
  @@map("invitations")
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  ssoIdentityId String? @db.Uuid @map("sso_identity_id")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ssoIdentity ExternalIdentity? @relation(fields: [ssoIdentityId], references: [id], onDelete: Cascade)
  ssoFlows SsoFlow[]
  @@index([userId])
  @@index([ssoIdentityId])
  @@map("sessions")
}
// External subject identity from kokoro-account's OauthAccount model, generalized to issuer/sub.
model ExternalIdentity {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  providerId String @map("provider_id")
  issuer String
  subject String
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]
  mfaChallenges SsoMfaChallenge[]
  @@unique([issuer, subject])
  @@unique([userId, providerId])
  @@map("external_identities")
}
model SsoFlow {
  id String @id @default(uuid()) @db.Uuid
  stateHash String @unique @map("state_hash")
  bindingHash String @map("binding_hash")
  providerId String @map("provider_id")
  configHash String @map("config_hash")
  nonce String
  encryptedVerifier String @map("encrypted_verifier")
  linkSessionId String? @db.Uuid @map("link_session_id")
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  linkSession Session? @relation(fields: [linkSessionId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([linkSessionId])
  @@map("sso_flows")
}
model SsoMfaChallenge {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  identityId String @db.Uuid @map("identity_id")
  configHash String @map("config_hash")
  attemptsLeft Int @map("attempts_left")
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  identity ExternalIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([identityId])
  @@map("sso_mfa_challenges")
}
model AccountToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  purpose TokenPurpose
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
  @@map("account_tokens")
}
model RecoveryCode {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  codeHash String @unique @map("code_hash")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("recovery_codes")
}
model ServiceAccount {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid @map("organization_id")
  name String
  disabled Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  apiKeys ApiKey[]
  @@unique([id, orgId])
  @@index([orgId])
  @@map("service_accounts")
}
model ApiKey {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid @map("organization_id")
  userId String? @db.Uuid @map("user_id")
  serviceAccountId String? @db.Uuid @map("service_account_id")
  name String
  keyHash String @unique @map("key_hash")
  prefix String
  scopes String[]
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  revokedAt DateTime? @db.Timestamptz @map("revoked_at")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceAccount ServiceAccount? @relation(fields: [serviceAccountId, orgId], references: [id, orgId], onDelete: NoAction)
  @@index([orgId])
  @@index([userId])
  @@index([serviceAccountId, orgId])
  @@map("api_keys")
}
model Credential {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid @map("organization_id")
  name String
  provider String
  providerRef String @map("provider_ref")
  encryptedSecret String? @map("encrypted_secret")
  revokedAt DateTime? @db.Timestamptz @map("revoked_at")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@unique([orgId, provider, providerRef])
  @@map("credentials")
}
model Operation {
  id String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid @map("organization_id")
  requestKey String @map("request_key")
  requestHash String @map("request_hash")
  kind String
  input Json
  credentialId String? @db.Uuid @map("credential_id")
  status OperationStatus @default(PENDING)
  errorCode String? @map("error_code")
  leaseUntil DateTime @db.Timestamptz @map("lease_until")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@unique([orgId, requestKey])
  @@map("operations")
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  orgId String? @db.Uuid @map("organization_id")
  actorId String? @db.Uuid @map("actor_id")
  action String
  resourceId String? @map("resource_id")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  @@index([orgId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
model EmailLog {
  id String @id @default(uuid()) @db.Uuid
  to String
  template String
  status String
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  @@map("email_logs")
}
// Durable integration facts deliberately survive product data deletion.
model IntegrationEvent {
  id String @id @db.Uuid
  orgId String? @db.Uuid @map("organization_id")
  type String
  body Json
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz @map("available_at")
  deliveredAt DateTime? @db.Timestamptz @map("delivered_at")
  leaseUntil DateTime? @db.Timestamptz @map("lease_until")
  leaseToken String? @db.Uuid @map("lease_token")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at")
  @@index([deliveredAt, availableAt])
  @@index([orgId, createdAt])
  @@map("integration_events")
}
